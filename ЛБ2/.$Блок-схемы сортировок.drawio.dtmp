        <mxCell id="init" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" value="pivot = a[left + (right − left) / 2]&#xa;i = left − 1; j = right + 1" vertex="1">
