        <mxCell id="while" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rhombus;" value="left &lt; right?" vertex="1">
