        <mxCell id="size" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rhombus;" value="p − left &lt; right − p − 1?" vertex="1">
