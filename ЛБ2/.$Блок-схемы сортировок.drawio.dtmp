        <mxCell id="dec" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" value="j = j − 1" vertex="1">
