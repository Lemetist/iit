  <diagram name="4. Разбиение Хоара" id="page3">
    <mxGraphModel dx="2175" dy="1297" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1400" math="0" shadow="0">
      <root>
