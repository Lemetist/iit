        </mxCell>
        <mxCell id="pushR" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" value="ls[top] = p + 1&#xa;rs[top] = right&#xa;top = top + 1&#xa;right = p" vertex="1">
          <mxGeometry height="120" width="290" x="120" y="890" as="geometry" />
        </mxCell>
        <mxCell id="pushL" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" value="ls[top] = left&#xa;rs[top] = p&#xa;top = top + 1&#xa;left = p + 1" vertex="1">
          <mxGeometry height="120" width="290" x="760" y="890" as="geometry" />
        </mxCell>
        <mxCell id="empty" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rhombus;" value="top = 0?" vertex="1">
          <mxGeometry height="110" width="250" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="pop" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" value="top = top − 1&#xa;left = ls[top]&#xa;right = rs[top]" vertex="1">
          <mxGeometry height="100" width="250" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=1;arcSize=50;" value="Конец: массив отсортирован" vertex="1">
