        <mxCell id="part" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;shape=process;" value="p = partition(a, left, right)" vertex="1">
