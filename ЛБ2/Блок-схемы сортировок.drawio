<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram name="1. Сортировка вставками" id="page0">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Сортировка вставками — insertion(a, n)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="Начало: массив a, длина n" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="init" value="i = 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="outer" value="i &lt; n?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rhombus;" vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="save" value="x = a[i]&#10;j = i − 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="450" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inner" value="j ≥ 0 и a[j] &gt; x?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rhombus;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="shift" value="a[j + 1] = a[j]&#10;j = j − 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="580" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="insert" value="a[j + 1] = x" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="730" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inc" value="i = i + 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="840" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="Конец: массив отсортирован" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;strokeColor=#000000;fillColor=#ffffff;align=center;verticalAlign=middle;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="init">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="init" target="outer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="outer" target="save">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="outer" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="save" target="inner">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inner" target="shift">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="shift" target="inner">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="520"/>
              <mxPoint x="450" y="520"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inner" target="insert">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="insert" target="inc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inc" target="outer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="870"/>
              <mxPoint x="290" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
      <mxCell id="figure-caption" value="Рисунок 1 — Сортировка вставками" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="840" height="60" as="geometry"/></mxCell></root>
    </mxGraphModel>
